# Copy to local.env (not committed) and set what run_game.sh can't find by itself.
# Usual macOS and Linux installs (Steam or standalone) are found without it.

# The Factorio executable (2.1).
#   macOS, Steam:  $HOME/Library/Application Support/Steam/steamapps/common/Factorio/factorio.app/Contents/MacOS/factorio
#   Linux, Steam:  $HOME/.steam/steam/steamapps/common/Factorio/bin/x64/factorio
#FACTORIO_BIN="$HOME/factorio/bin/x64/factorio"

# Your mods folder: Krastorio 2 and the other mods the tests use are linked from here
# (never copied or changed), and `dump` takes your enabled mod list from it.
#FACTORIO_MODS="$HOME/.factorio/mods"

# Your saves folder, for `dump "<save>"` (default: next to the mods folder).
#FACTORIO_SAVES="$HOME/.factorio/saves"
